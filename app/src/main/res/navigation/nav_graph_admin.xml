<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_admin"
    app:startDestination="@id/adminHomeFragment">
    <fragment
        android:id="@+id/adminHomeFragment"
        android:name="com.example.apppanadero.ui.AdminHomeFragment"
        android:label="AdminHomeFragment" >
        <action
            android:id="@+id/action_adminHomeFragment_to_adminPedidosFragment"
            app:destination="@id/adminPedidosFragment" />
        <action
            android:id="@+id/action_adminHomeFragment_to_adminProductosFragment"
            app:destination="@id/adminProductosFragment" />
        <action
            android:id="@+id/action_adminHomeFragment_to_adminClientesFragment"
            app:destination="@id/adminClientesFragment" />
    </fragment>
    <fragment
        android:id="@+id/adminPedidosFragment"
        android:name="com.example.apppanadero.ui.AdminPedidosFragment"
        android:label="AdminPedidosFragment" >
        <action
            android:id="@+id/action_adminPedidosFragment_to_adminDetallePedidoFragment"
            app:destination="@id/adminDetallePedidoFragment" />
    </fragment>
    <fragment
        android:id="@+id/adminClientesFragment"
        android:name="com.example.apppanadero.ui.AdminClientesFragment"
        android:label="AdminClientesFragment" >
        <action
            android:id="@+id/action_adminClientesFragment_to_adminHistoricoClientesFragment"
            app:destination="@id/adminHistoricoClientesFragment" />
    </fragment>
    <fragment
        android:id="@+id/adminProductosFragment"
        android:name="com.example.apppanadero.ui.AdminProductosFragment"
        android:label="AdminProductosFragment" >
        <action
            android:id="@+id/action_adminProductosFragment_to_adminNuevoProductoFragment"
            app:destination="@id/adminNuevoProductoFragment" />
    </fragment>
    <fragment
        android:id="@+id/adminDetallePedidoFragment"
        android:name="com.example.apppanadero.ui.AdminDetallePedidoFragment"
        android:label="AdminDetallePedidoFragment" >
        <argument
            android:name="pedidoId"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/adminNuevoProductoFragment"
        android:name="com.example.apppanadero.ui.AdminNuevoProductoFragment"
        android:label="AdminNuevoProductoFragment" >
        <argument
            android:name="productoId"
            app:argType="string"
            android:defaultValue="@null"
            app:nullable="true"/>
    </fragment>
    <fragment
        android:id="@+id/adminHistoricoClientesFragment"
        android:name="com.example.apppanadero.ui.AdminHistoricoClientesFragment"
        android:label="AdminHistoricoClientesFragment" >
        <argument
            android:name="clienteId"
            app:argType="string" />
    </fragment>
</navigation>