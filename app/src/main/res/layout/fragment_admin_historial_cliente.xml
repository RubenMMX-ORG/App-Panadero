<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_card">

    <!-- CONTENEDOR PRINCIPAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- SUBTÍTULO -->

        <!-- ========================================================= -->
        <!-- CARD PRINCIPAL -->
        <!-- ========================================================= -->

        <com.google.android.material.card.MaterialCardView
            style="@style/CardSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ========================================================= -->
                <!-- TOP -->
                <!-- ========================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- IMAGEN -->
                    <ImageView
                        android:id="@+id/imgComercio"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:padding="4dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/mercado" />

                    <!-- INFORMACIÓN -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- NOMBRE -->
                        <TextView
                            android:id="@+id/tvNombreComercio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Panadería Central"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <!-- DIRECCIÓN -->
                        <TextView
                            android:id="@+id/tvDireccion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Calle Mayor 24, Madrid"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <!-- TELÉFONO -->
                        <TextView
                            android:id="@+id/tvTelefono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="📞 666 555 444"
                            android:textColor="@color/primary_dark"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ========================================================= -->
                <!-- RUTA + DESCUENTO -->
                <!-- ========================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- RUTA -->
                    <TextView
                        android:id="@+id/tvRuta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🚚 Ruta Norte"
                        android:textColor="@color/primary_dark"
                        android:textStyle="bold" />

                    <!-- DESCUENTO -->
                    <TextView
                        android:id="@+id/tvDescuento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10% dto."
                        android:textColor="@color/estado_pendiente_text"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- ========================================================= -->
                <!-- APROBADO + SELECTOR DESCUENTO -->
                <!-- ========================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- TEXTO -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Aprobado"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <!-- SWITCH -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAprobado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:thumbTint="@color/primary_color"
                        app:trackTint="@color/primary_light" />

                    <!-- ESPACIADOR -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- DROPDOWN -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.App.Dropdown"
                        android:layout_width="110dp"
                        android:layout_height="wrap_content">

                        <AutoCompleteTextView
                            android:id="@+id/dropdownDescuento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:text="0%"
                            android:textColor="@color/text_primary" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ========================================================= -->
        <!-- FILA FECHAS -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- FECHA INICIO -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.App.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFechaInicio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:drawableStart="@android:drawable/ic_menu_today"
                    android:focusable="false"
                    android:hint="Desde"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- FECHA FIN -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.App.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFechaFin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:drawableStart="@android:drawable/ic_menu_today"
                    android:focusable="false"
                    android:hint="Hasta"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"/>

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- ========================================================= -->
        <!-- TÍTULO PRODUCTOS -->
        <!-- ========================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:text="Detalle por producto"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- ========================================================= -->
        <!-- RECYCLER -->
        <!-- ========================================================= -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerProductos"
            android:layout_width="match_parent"
            android:layout_height="140dp" />

        <!-- ========================================================= -->
        <!-- CARD RESUMEN -->
        <!-- ========================================================= -->

        <com.google.android.material.card.MaterialCardView
            style="@style/CardSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- TÍTULO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Resumen del período"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- TOTAL PEDIDOS -->
                <TextView
                    android:id="@+id/tvTotalPedidos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total pedidos: 1530 uds"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <!-- TOTAL DEVUELTOS -->
                <TextView
                    android:id="@+id/tvTotalDevueltos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total devueltos: 150 uds"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <!-- TOTAL NETO -->
                <TextView
                    android:id="@+id/tvTotalNeto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Total neto: 1380 uds"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ========================================================= -->
        <!-- BOTÓN PDF -->
        <!-- ========================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImprimir"
            style="@style/ButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Imprimir Facturación PDF"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="50dp"
            app:icon="@drawable/ic_print"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

    </LinearLayout>

</ScrollView>