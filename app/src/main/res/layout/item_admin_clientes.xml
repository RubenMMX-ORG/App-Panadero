<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    style="@style/CardSecondary"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp">

    <!-- ========================================================= -->
    <!-- CONTENEDOR -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ========================================================= -->
        <!-- TOP -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- ========================================================= -->
            <!-- IMAGEN COMERCIO -->
            <!-- ========================================================= -->

            <ImageView
                android:id="@+id/imgComercio"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:padding="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/mercado" />

            <!-- ========================================================= -->
            <!-- INFORMACIÓN -->
            <!-- ========================================================= -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- NOMBRE -->
                <TextView
                    android:id="@+id/tvNombreComercio"
                    style="@style/TextTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Panadería Central"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- DIRECCIÓN -->
                <TextView
                    android:id="@+id/tvDireccion"
                    style="@style/TextLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Calle Mayor 24, Madrid"
                    android:textColor="@color/text_secondary" />

                <!-- TELÉFONO -->
                <TextView
                    android:id="@+id/tvTelefono"
                    style="@style/TextLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="📞 666 555 444"
                    android:textColor="@color/primary_dark" />

            </LinearLayout>

        </LinearLayout>

        <!-- ========================================================= -->
        <!-- ACCIONES -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- ========================================================= -->
            <!-- CHIP APROBADO -->
            <!-- ========================================================= -->

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAprobado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aprobado"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                app:chipBackgroundColor="@color/estado_entregado_bg"
                app:chipCornerRadius="16dp"
                app:chipStrokeColor="@color/primary_color"
                app:chipStrokeWidth="1dp" />

            <!-- ========================================================= -->
            <!-- ESPACIADOR -->
            <!-- ========================================================= -->

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- ========================================================= -->
            <!-- BOTÓN DETALLE -->
            <!-- ========================================================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetalleCliente"
                style="@style/ButtonPrimary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Detalle cliente"
                android:textAllCaps="false"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>