<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4EDE4"
    android:padding="30dp">
    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F4EDE4"
        android:minHeight="?attr/actionBarSize"
        app:title=""
        app:elevation="0dp"/>

    <!-- LOGO -->


    <ImageView
        android:layout_width="120dp"
        android:layout_height="135dp"
        android:layout_gravity="center"
        android:src="@drawable/logo_panadero" />


    <!-- TITULO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="El Panadero"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#7A3E1D"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"/>

    <!-- USUARIO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Introduzca Usuario"
        android:textColor="#7A3E1D"
        android:layout_marginTop="32dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="#FFFFFF"
        app:boxStrokeColor="#D2691E"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Usuario"
            android:textColor="#000000"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- PASSWORD -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Introduzca contraseña"
        android:textColor="#7A3E1D"
        android:layout_marginTop="16dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="#FFFFFF"
        app:boxStrokeColor="#D2691E"
        app:passwordToggleEnabled="true"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:textColor="#000000"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- RECORDAR -->
    <CheckBox
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recordar contraseña"
        android:textColor="#7A3E1D"
        android:layout_marginTop="8dp"/>

    <!-- BOTON -->
    <com.google.android.material.button.MaterialButton
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="ACCEDER"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:backgroundTint="#C89A6A"
        app:cornerRadius="20dp"
        android:elevation="6dp"/>

    <!-- GOOGLE -->
    <com.google.android.material.button.MaterialButton
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Iniciar con Google"
        android:textColor="#000000"
        android:layout_marginTop="16dp"
        app:cornerRadius="20dp"
        android:backgroundTint="#FFFFFF"
        app:icon="@drawable/ic_google"
        app:iconTint="@null"
        app:iconPadding="8dp"/>

    <!-- REGISTRO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:linksClickable="true"
        android:text="¿No tienes cuenta? Regístrate"
        android:textColor="#7A3E1D" />

</LinearLayout>