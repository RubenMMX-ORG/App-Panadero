<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_background">

    <!-- TOOLBAR -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarDetalle"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary_color"
            app:title="Detalle del Pedido"
            app:titleCentered="true"
            app:titleTextColor="@android:color/white"
            app:navigationIcon="@drawable/ic_back"/>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- CONTENIDO -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Nº PEDIDO -->
            <TextView
                android:id="@+id/tvNumeroPedido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pedido #1"
                android:textSize="18sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="12dp"/>

            <!-- CARD INFO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/primary_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- FECHA -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fecha"
                        android:textColor="@color/text_secondary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvFecha"
                        android:text="2026-03-30"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/primary_dark"
                        android:layout_marginBottom="8dp"/>

                    <!-- HORA -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hora"
                        android:textColor="@color/text_secondary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvHora"
                        android:text="09:30"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/primary_dark"
                        android:layout_marginBottom="8dp"/>

                    <!-- ESTADO -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estado"
                        android:textColor="@color/text_secondary"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipEstado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="En preparación"
                        app:chipCornerRadius="16dp"
                        app:chipStrokeWidth="1dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- TÍTULO PRODUCTOS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Productos"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primary_dark"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <!-- RECYCLERVIEW -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- BOTONES ABAJO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:weightSum="2"
        android:layout_gravity="bottom">

        <!-- CANCELAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancelar Pedido"
            android:textAllCaps="false"
            android:textColor="@color/estado_finalizado_text"
            app:strokeColor="@color/estado_finalizado_border"
            app:strokeWidth="2dp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="16dp"/>

        <!-- MODIFICAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModificar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Modificar Pedido"
            android:textAllCaps="false"
            android:layout_marginStart="8dp"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/primary_color"
            app:cornerRadius="16dp"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>