<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    style="@style/CardSecondary"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp">

    <!-- ========================================================= -->
    <!-- CONTENEDOR -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ========================================================= -->
        <!-- TOP -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- ========================================================= -->
            <!-- ICONO -->
            <!-- ========================================================= -->

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_light"
                android:padding="8dp"
                android:src="@drawable/ic_user" />

            <!-- ========================================================= -->
            <!-- NOMBRE + PEDIDO -->
            <!-- ========================================================= -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- NOMBRE -->
                <TextView
                    android:id="@+id/tvNombreComercio"
                    style="@style/TextTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Juan Pérez"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- PEDIDO -->
                <TextView
                    android:id="@+id/tvNumeroPedido"
                    style="@style/TextLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pedido #1"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

            <!-- ========================================================= -->
            <!-- CHIP ESTADO -->
            <!-- ========================================================= -->

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pendiente"
                app:chipCornerRadius="16dp"
                app:chipStrokeWidth="1dp" />

        </LinearLayout>

        <!-- ========================================================= -->
        <!-- FECHA Y HORA -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- FECHA -->
            <TextView
                android:id="@+id/tvFecha"
                style="@style/TextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="📅 2026-03-31"
                android:textColor="@color/primary_dark" />

            <!-- HORA -->
            <TextView
                android:id="@+id/tvHora"
                style="@style/TextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏰ 09:30"
                android:textColor="@color/primary_dark" />

        </LinearLayout>

        <!-- ========================================================= -->
        <!-- PRODUCTOS + PRECIO -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <!-- PRODUCTOS -->
            <TextView
                android:id="@+id/tvCantidad"
                style="@style/TextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11 productos"
                android:textColor="@color/text_secondary" />

            <!-- PRECIO -->
            <TextView
                android:id="@+id/tvPrecio"
                style="@style/TextPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="50dp"
                android:text="€23,80"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ========================================================= -->
        <!-- BOTONES -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- BOTÓN INICIAR RUTA -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIniciarRuta"
                style="@style/ButtonSecondary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Iniciar ruta"
                android:textAllCaps="false"
                app:cornerRadius="16dp" />

            <!-- BOTÓN DETALLE -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetalle"
                style="@style/ButtonPrimary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Ver detalle"
                android:textAllCaps="false"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>