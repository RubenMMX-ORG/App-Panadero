<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_background">

    <!-- TOOLBAR -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarRepartidor"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary_color"
            app:title="Panel de Repartidor"
            app:titleCentered="true"
            app:titleTextColor="@android:color/white"
            app:menu="@menu/menu_home"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- CONTENIDO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- LOGO -->
            <ImageView
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginTop="8dp"
                android:src="@drawable/logo_panadero"/>

            <!-- TITULO -->
            <TextView
                android:layout_marginTop="12dp"
                android:text="Panel de Repartidor"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/primary_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="Gestiona tus entregas"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- BOTÓN RUTA -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRuta"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:backgroundTint="@color/primary_light"
                android:text="Ver ruta de reparto"
                android:textColor="@android:color/white"
                app:cornerRadius="20dp"
                app:icon="@android:drawable/ic_menu_mapmode"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <!-- BOTÓN PEDIDOS HOY -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPedidosHoy"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="12dp"
                android:text="Pedidos de hoy"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/primary_color"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_list"
                app:iconGravity="textStart"
                app:iconPadding="8dp"/>

            <!-- HEADER PEDIDOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Pedidos Pendientes"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/primary_dark"
                    android:layout_height="32dp"/>

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_button_primary"/>
            </LinearLayout>

            <!-- CARD PEDIDO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- NOMBRE + ESTADO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="Juan Pérez"
                                android:textStyle="bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:text="Pedido #1"
                                android:textColor="@color/text_secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <TextView
                            android:text="Pendiente"
                            android:textSize="12sp"
                            android:textColor="#8A6D00"
                            android:background="@drawable/bg_estado_pendiente"
                            android:padding="6dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- DIRECCIÓN -->
                    <TextView
                        android:layout_marginTop="8dp"
                        android:text="📍 Calle Mayor, 45 - 2ºB"
                        android:textColor="@color/text_secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- HORA -->
                    <TextView
                        android:text="⏰ Entrega: 09:30"
                        android:textColor="@color/text_secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- BOTONES -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:text="Iniciar Ruta"
                            android:textColor="@android:color/white"
                            android:backgroundTint="@color/primary_color"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_navigation"/>

                        <Space
                            android:layout_width="8dp"
                            android:layout_height="wrap_content"/>

                        <com.google.android.material.button.MaterialButton
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="Ver Detalle"
                            android:textColor="@color/primary_dark"
                            android:backgroundTint="@android:color/transparent"
                            app:strokeColor="@color/primary_color"
                            app:strokeWidth="2dp"
                            app:cornerRadius="16dp"/>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>