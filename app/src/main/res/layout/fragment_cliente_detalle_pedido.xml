<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_pan">

    <!-- ========================================================= -->
    <!-- SCROLL -->
    <!-- ========================================================= -->

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingBottom="120dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ========================================================= -->
        <!-- CARD PRINCIPAL -->
        <!-- ========================================================= -->

        <com.google.android.material.card.MaterialCardView
            style="@style/CardPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- ========================================================= -->
                <!-- Nº PEDIDO -->
                <!-- ========================================================= -->

                <TextView
                    android:id="@+id/tvNumeroPedido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Pedido #1"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- ========================================================= -->
                <!-- CARD INFO -->
                <!-- ========================================================= -->

                <com.google.android.material.card.MaterialCardView
                    style="@style/CardSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- ========================================================= -->
                        <!-- FECHA -->
                        <!-- ========================================================= -->

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fecha"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvFecha"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="2026-03-30"
                            android:textColor="@color/primary_dark"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- ========================================================= -->
                        <!-- ESTADO -->
                        <!-- ========================================================= -->

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Estado"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipEstado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:text="En preparación"
                            app:chipCornerRadius="16dp"
                            app:chipStrokeWidth="1dp" />

                        <!-- ========================================================= -->
                        <!-- RESUMEN -->
                        <!-- ========================================================= -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- PRODUCTOS -->
                            <TextView
                                android:id="@+id/tvNumProductos"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="5 productos"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold" />

                            <!-- TOTAL -->
                            <TextView
                                android:id="@+id/tvTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="€24.50"
                                android:textColor="@color/primary_dark"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ========================================================= -->
                <!-- TÍTULO PRODUCTOS -->
                <!-- ========================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:text="Productos"
                    android:textColor="@color/primary_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- ========================================================= -->
                <!-- LISTA -->
                <!-- ========================================================= -->

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="350dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.core.widget.NestedScrollView>

    <!-- ========================================================= -->
    <!-- CARD BOTONES -->
    <!-- ========================================================= -->

    <com.google.android.material.card.MaterialCardView
        style="@style/CardPrimary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:weightSum="2">

            <!-- ========================================================= -->
            <!-- BOTÓN CANCELAR -->
            <!-- ========================================================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textColor="@color/estado_finalizado_text"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="16dp"
                app:strokeColor="@color/estado_finalizado_bg"
                app:strokeWidth="2dp" />

            <!-- ========================================================= -->
            <!-- BOTÓN MODIFICAR -->
            <!-- ========================================================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModificar"
                style="@style/ButtonPrimary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Modificar"
                android:textAllCaps="false"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>